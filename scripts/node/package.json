{
  "name": "scripts-node",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "eval:breakdown-models": "bun src/cli/eval-breakdown-models.ts",
    "lint:md": "bun src/cli/lint-md.ts --",
    "example": "bun src/cli/example.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --apply src/"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "cleye": "^1.3.0",
    "remark": "15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-lint": "10.0.1",
    "remark-lint-no-duplicate-headings": "4.0.1",
    "remark-lint-no-heading-punctuation": "4.0.1",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.2.0",
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3"
  }
}
