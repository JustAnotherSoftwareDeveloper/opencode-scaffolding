{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode.local/schema/skill-facet-registry-1.0.json",
  "title": "Skill facet registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "facets"],
  "properties": {
    "$schema": {"type": "string"},
    "namespace": {"$ref": "#/$defs/name"},
    "facets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/facet"}
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "facetIdentity": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?::[a-z][a-z0-9]*(?:-[a-z0-9]+)*)?$"
    },
    "singleLine": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
    },
    "strings": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"allOf": [{"$ref": "#/$defs/singleLine"}, {"maxLength": 256}]}
    },
    "cueStrings": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"allOf": [{"$ref": "#/$defs/singleLine"}, {"maxLength": 64}]}
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {"allOf": [{"$ref": "#/$defs/singleLine"}, {"maxLength": 64}]},
        "aliases": {"$ref": "#/$defs/cueStrings"},
        "parents": {"$ref": "#/$defs/strings"},
        "status": {"enum": ["active", "deprecated"]},
        "replacement": {"allOf": [{"$ref": "#/$defs/singleLine"}, {"maxLength": 64}]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "deprecated"}}, "required": ["status"]},
          "then": {"required": ["replacement"]}
        },
        {
          "if": {"properties": {"status": {"const": "active"}}, "required": ["status"]},
          "then": {"not": {"required": ["replacement"]}}
        },
        {
          "if": {"required": ["replacement"]},
          "then": {"properties": {"status": {"const": "deprecated"}}, "required": ["status"]}
        }
      ]
    },
    "facet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "meaning"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "meaning": {"allOf": [{"$ref": "#/$defs/singleLine"}, {"maxLength": 256}]},
        "value_shape": {"type": "string", "minLength": 1, "maxLength": 256},
        "examples": {"$ref": "#/$defs/strings"},
        "aliases": {"$ref": "#/$defs/strings"},
        "parents": {"$ref": "#/$defs/strings"},
        "status": {"enum": ["active", "deprecated"]},
        "replacement": {"$ref": "#/$defs/facetIdentity"},
        "values": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/value"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "deprecated"}}, "required": ["status"]},
          "then": {"required": ["replacement"]}
        },
        {
          "if": {"properties": {"status": {"const": "active"}}, "required": ["status"]},
          "then": {"not": {"required": ["replacement"]}}
        },
        {
          "if": {"required": ["replacement"]},
          "then": {"properties": {"status": {"const": "deprecated"}}, "required": ["status"]}
        }
      ]
    }
  }
}
