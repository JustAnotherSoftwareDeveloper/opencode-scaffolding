{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode.local/schema/skill-routing-1.0.json",
  "title": "Skill routing signature",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cues", "relationships"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "cues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/cue"}
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relationship"}
    }
  },
  "$defs": {
    "singleLine": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
    },
    "facetName": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?::[a-z][a-z0-9]*(?:-[a-z0-9]+)*)?$"
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facet", "value"],
      "properties": {
        "facet": {"$ref": "#/$defs/facetName"},
        "value": {"allOf": [{"$ref": "#/$defs/singleLine"}, {"maxLength": 64}]},
        "aliases": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"allOf": [{"$ref": "#/$defs/singleLine"}, {"maxLength": 64}]}
        },
        "primary": {"type": "boolean"}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": {"enum": ["owner", "support", "reference"]},
        "target": {"allOf": [{"$ref": "#/$defs/singleLine"}, {"maxLength": 128}]},
        "rationale": {"allOf": [{"$ref": "#/$defs/singleLine"}, {"maxLength": 256}]}
      }
    }
  }
}
