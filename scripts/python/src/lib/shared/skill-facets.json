{
  "$schema": "https://opencode.local/schema/skill-facet-registry-1.0.json",
  "namespace": "builtin",
  "facets": [
    {"name": "operation", "meaning": "Action the skill owns", "examples": ["validate", "summarize"]},
    {"name": "subject", "meaning": "Thing or material acted upon"},
    {"name": "outcome", "meaning": "Meaningful result the task seeks"},
    {"name": "interface", "meaning": "Interaction or input/output boundary"},
    {"name": "environment", "meaning": "Named execution or working context"},
    {"name": "constraint", "meaning": "Requirement that materially changes routing"}
  ]
}
