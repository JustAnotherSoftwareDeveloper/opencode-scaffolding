<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    targetNamespace="https://opencode.dev/schemas/class-contract"
    xmlns="https://opencode.dev/schemas/class-contract"
    elementFormDefault="qualified">

    <xs:complexType name="SkillContract">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="description" type="xs:string"/>
            <xs:element name="class">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:enumeration value="operation"/>
                        <xs:enumeration value="delegated"/>
                        <xs:enumeration value="inline"/>
                        <xs:enumeration value="orchestrated"/>
                        <xs:enumeration value="planning"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

</xs:schema>