<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:annotation><xs:documentation>Delegated skills are worker-executed backing specialists spawned by an orchestrator; they must define one bounded worker objective, input contract, output contract, execution context, state boundaries, validation/evidence requirements, and failure reporting.</xs:documentation></xs:annotation>
  <xs:element name="skill_class_manifest">
    <xs:annotation><xs:documentation>Canonical XML manifest shape for a delegated skill class review.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="class_name" type="delegatedClass" />
        <xs:element name="purpose" type="nonEmptyString" />
        <xs:element name="use_when" type="nonEmptyString" />
        <xs:element name="do_not_use_when" type="nonEmptyString" />
        <xs:element name="required_frontmatter" type="frontmatterType" />
        <xs:element name="hygiene_checks" type="listType" />
        <xs:element name="validation" type="listType" />
        <xs:element name="bounded_worker_objective" type="nonEmptyString" />
        <xs:element name="input_contract" type="contractType" />
        <xs:element name="output_contract" type="contractType" />
        <xs:element name="execution_context" type="nonEmptyString" />
        <xs:element name="state_boundaries" type="nonEmptyString" />
        <xs:element name="validation_evidence_requirements" type="listType" />
        <xs:element name="failure_reporting" type="nonEmptyString" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="delegatedClass"><xs:restriction base="xs:string"><xs:enumeration value="delegated" /></xs:restriction></xs:simpleType>
  <xs:simpleType name="nonEmptyString"><xs:restriction base="xs:string"><xs:minLength value="1" /></xs:restriction></xs:simpleType>
  <xs:complexType name="frontmatterType"><xs:sequence><xs:element name="field" minOccurs="3" maxOccurs="unbounded"><xs:complexType><xs:simpleContent><xs:extension base="nonEmptyString"><xs:attribute name="name" use="required" type="nonEmptyString" /></xs:extension></xs:simpleContent></xs:complexType></xs:element></xs:sequence></xs:complexType>
  <xs:complexType name="listType"><xs:sequence><xs:element name="item" type="nonEmptyString" maxOccurs="unbounded" /></xs:sequence></xs:complexType>
  <xs:complexType name="contractType">
    <xs:sequence>
      <xs:element name="description" type="nonEmptyString" />
      <xs:element name="format" type="nonEmptyString" minOccurs="0" />
      <xs:element name="constraints" type="listType" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>
</xs:schema>