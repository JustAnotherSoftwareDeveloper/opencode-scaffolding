{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BreakdownTasksOutput",
  "description": "Output of the breakdown-tasks skill: a list of atomic delegation packets that together fulfill a user request.",
  "type": "object",
  "additionalProperties": false,
        "properties": {
    "summary": { "$ref": "#/definitions/PacketSummary" },
    "slug": { "$ref": "#/definitions/PacketSlug" },
    "tasks": {
      "description": "An ordered, uncapped list of atomic delegation packets. Create as many tasks as the independent work requires; each task must represent one unit of work that can be completed and verified independently.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/TaskPacket"
      },
      "minItems": 1
    },
    "boundaryReview": { "$ref": "#/definitions/BoundaryReview" }
  },
  "required": ["summary", "slug", "tasks", "boundaryReview"],
  "definitions": {
    "BoundaryReview": {
      "description": "Required request-aware boundary-review evidence. It documents review reasoning and does not prove semantic atomicity or alter task-contract meanings. All dispositions are closed; unresolved evidence is not representable.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestResultInventory": {
          "description": "Request-derived immediate and necessary intermediate results, keyed by unique inventory identifier.",
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]{0,63}$": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "result": { "type": "string", "minLength": 1 },
                "kind": { "type": "string", "enum": ["immediate", "necessary-intermediate"] },
                "disposition": { "type": "string", "enum": ["represented-by-task", "split-into-tasks", "not-applicable"] }
              },
              "required": ["result", "kind", "disposition"]
            }
          },
          "additionalProperties": false
        },
        "taskReviews": {
          "description": "Per-task immediate-result and fixed-predecessor-output mapping, keyed by unique taskId.",
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]{0,63}$": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "immediateResult": { "type": "string", "minLength": 1 },
                "predecessorOutputs": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "uniqueItems": true
                },
                "preAssignmentDisposition": { "type": "string", "enum": ["single-result", "retained-indivisible"] },
                "acceptanceDisposition": { "type": "string", "enum": ["accepted", "accepted-indivisible"] },
                "indivisibilityEvidence": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sharedResult": { "type": "string", "minLength": 1 },
                    "verificationBoundary": { "type": "string", "minLength": 1 },
                    "separationHarm": { "type": "string", "minLength": 1 }
                  },
                  "required": ["sharedResult", "verificationBoundary", "separationHarm"]
                }
              },
              "required": ["immediateResult", "predecessorOutputs", "preAssignmentDisposition", "acceptanceDisposition"],
              "allOf": [
                {
                  "if": {
                    "anyOf": [
                      { "properties": { "preAssignmentDisposition": { "const": "retained-indivisible" } }, "required": ["preAssignmentDisposition"] },
                      { "properties": { "acceptanceDisposition": { "const": "accepted-indivisible" } }, "required": ["acceptanceDisposition"] }
                    ]
                  },
                  "then": { "required": ["indivisibilityEvidence"] }
                }
              ],
              "oneOf": [
                {
                  "properties": {
                    "preAssignmentDisposition": { "const": "single-result" },
                    "acceptanceDisposition": { "const": "accepted" }
                  },
                  "required": ["preAssignmentDisposition", "acceptanceDisposition"]
                },
                {
                  "properties": {
                    "preAssignmentDisposition": { "const": "retained-indivisible" },
                    "acceptanceDisposition": { "const": "accepted-indivisible" }
                  },
                  "required": ["preAssignmentDisposition", "acceptanceDisposition"]
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "warningDispositions": {
          "description": "Structural warning decisions, keyed by unique warning identifier. Every disposition is closed.",
          "type": "object",
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]{0,63}$": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "signal": { "type": "string", "minLength": 1 },
                "taskId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
                "disposition": { "type": "string", "enum": ["split", "accepted-indivisible", "not-applicable"] }
              },
              "required": ["signal", "disposition"],
              "allOf": [
                {
                  "if": {
                    "properties": { "disposition": { "const": "accepted-indivisible" } },
                    "required": ["disposition"]
                  },
                  "then": { "required": ["taskId"] }
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["requestResultInventory", "taskReviews", "warningDispositions"]
    },
    "PacketSlug": {
      "description": "Required lowercase ASCII kebab-case identity for this packet. It is preserved unchanged by packet consumers and publishers.",
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "PacketSummary": {
      "description": "One-paragraph summary of the overall user request, capturing its goal, scope, and constraints. This gives downstream workers context without requiring them to re-read the full prompt.",
      "type": "string"
    },
    "TaskPurpose": {
      "description": "Single sentence describing what this task accomplishes. Must be actionable and self-contained.",
      "type": "string"
    },
    "TaskContext": {
      "description": "Task-specific context for the worker. Include the relevant user-request details, background information, and constraints. Do not add filler text.",
      "type": "string"
    },
    "TaskExpectedOutput": {
      "description": "Precise description of the Deliverable payload this task produces. Use concrete language such as file paths, function names, and data formats.",
      "type": "string"
    },
    "TaskPacket": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "description": "Stable required identity for this task.",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "purpose": { "$ref": "#/definitions/TaskPurpose" },
        "context": { "$ref": "#/definitions/TaskContext" },
        "filesToRead": {
          "description": "Explicit list of file paths the worker must read before starting. Purposeful task-related discovery remains permitted under the worker contract.",
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "filesToWrite": {
          "description": "Explicit write boundary containing file paths or bounded path patterns the worker is authorized to create, modify, or delete.",
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
          "skills": {
          "description": "One to three skills the worker must load before executing. Each entry must match an available skill name exactly.",
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 3
        },
        "executionInstructions": {
          "description": "Step-by-step instructions for the worker. Each step is a discrete, verifiable action. Steps must be ordered and numbered.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 1
              },
              "action": {
                "type": "string",
                "description": "What to do in this step. Must be concrete and verifiable."
              },
              "verification": {
                "type": "string",
                "description": "Optional: how to verify this step succeeded (e.g., 'File exists at path X', 'Tests pass', 'No error output')."
              }
            },
            "required": ["step", "action"]
          },
          "minItems": 1,
          "maxItems": 5
        },
        "verification": {
          "description": "Top-level verification checks the worker must run against their output before finishing. These are checks on the complete deliverable, not per-step checks.",
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "expectedOutput": { "$ref": "#/definitions/TaskExpectedOutput" },
        "verificationCoverage": {
          "description": "Required publication metadata describing observable checks for this task.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "observable": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "uniqueItems": true
            },
            "coverage": {
              "type": "string",
              "enum": ["complete", "partial", "unknown"]
            }
          },
          "required": ["observable"]
        },
        "couplingRationale": {
          "description": "Optional inspectable exception for multiple files that publish one tightly coupled result.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "group": { "type": "string", "minLength": 1 },
            "rationale": { "type": "string", "minLength": 1 },
            "sharedResult": { "type": "string", "minLength": 1 },
            "verification": { "type": "string", "minLength": 1 }
          },
          "required": ["rationale", "sharedResult", "verification"]
        },
        "dependencies": {
          "description": "Required directed dependency edges. References use taskId.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "taskId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
              "reason": { "type": "string", "minLength": 1 }
            },
            "required": ["taskId"]
          }
        },
        "antiPatternSignals": {
          "description": "Required documented signals considered during authoring; signals are not proof of conceptual independence.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "none",
              "implementation-plus-independent-verification",
              "implementation-plus-tests",
              "multiple-helpers",
              "analysis-plus-planning",
              "multiple-comparisons",
              "multiple-analysis-questions",
              "multiple-operation-changes",
              "multiple-documentation-changes",
              "lifecycle-stage-bundle"
            ]
          },
          "uniqueItems": true
        },
        "purposeOutputAlignment": {
          "description": "Required explicit authoring assessment connecting the purpose to the expected output.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": { "type": "string", "enum": ["aligned", "needs-review", "not-aligned"] },
            "evidence": { "type": "string", "minLength": 1 }
          },
          "required": ["status", "evidence"]
        }
      },
      "required": ["taskId", "purpose", "context", "filesToRead", "filesToWrite", "skills", "executionInstructions", "expectedOutput", "verificationCoverage", "dependencies", "antiPatternSignals", "purposeOutputAlignment"]
    }
  }
}
