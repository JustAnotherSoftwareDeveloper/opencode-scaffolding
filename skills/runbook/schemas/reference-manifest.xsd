<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="reference-manifest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="generated" type="xs:dateTime" minOccurs="0" />
        <xs:element name="updated" type="xs:dateTime" minOccurs="0" />
        <xs:element name="runbook_id" type="xs:string" minOccurs="0" />
        <xs:element name="items">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="item" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="id" type="xs:string" use="required" />
                  <xs:attribute name="path" type="xs:string" use="required" />
                  <xs:attribute name="type" type="xs:string" use="required" />
                  <xs:attribute name="description" type="xs:string" use="optional" />
                  <xs:attribute name="checksum" type="xs:string" use="optional" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>