{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode.ai/skills/runbook/schemas/state-step.schema.json",
  "title": "Runbook State Step",
  "description": "State for a single step in the runbook execution",
  "type": "object",
  "required": [
    "step_id",
    "status",
    "objective"
  ],
  "properties": {
    "step_id": {
      "type": "string",
      "pattern": "^[0-9]{2}-[a-z0-9-]+$",
      "description": "ID of the step"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "blocked", "failed"],
      "description": "Current status of the step"
    },
    "objective": {
      "type": "string",
      "description": "Objective of the step"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of input files for the step"
    },
    "context_summary": {
      "type": "string",
      "description": "Summary of the context for the step"
    },
    "work_log": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Flexible free-text log entries for the step"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of output files generated by the step"
    },
    "verification": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "description": "Verification status"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Verification commands"
        },
        "details": {
          "type": "string",
          "description": "Optional free-text verification details"
        }
      },
      "additionalProperties": false,
      "description": "Verification information for the step"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of current blockers for the step"
    },
    "next_action": {
      "type": "string",
      "description": "Next action to take"
    },
    "worker": {
      "type": "string",
      "description": "Assigned worker identifier"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the step started"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the step completed"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Structured findings separate from work_log"
    },
    "design_summary": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional structured design notes produced by analysis or design steps"
    },
    "strictness_analysis": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional structured strictness or risk analysis produced by schema-design steps"
    }
  },
  "additionalProperties": false
}