{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode.ai/skills/runbook/schemas/state-main.schema.json",
  "title": "Runbook State Main",
  "description": "Main dashboard for the runbook execution state",
  "type": "object",
  "required": [
    "runbook_id",
    "title",
    "objective",
    "status",
    "active_step",
    "step_statuses",
    "blockers",
    "latest_verification"
  ],
  "properties": {
    "runbook_id": {
      "type": "string",
      "description": "Unique identifier for the runbook"
    },
    "title": {
      "type": "string",
      "description": "Title of the runbook"
    },
    "objective": {
      "type": "string",
      "description": "Objective of the runbook"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "executing", "blocked", "complete", "superseded"],
      "description": "Current status of the runbook"
    },
    "active_step": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{2}-[a-z0-9-]+$",
      "description": "ID of the currently active step"
    },
    "step_statuses": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Map of step IDs to their statuses"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of current blockers"
    },
    "latest_verification": {
      "type": ["string", "null"],
      "description": "Latest verification status or null if not verified"
    },
    "worker_assignments": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Map of step IDs to worker families"
    }
  },
  "additionalProperties": false
}