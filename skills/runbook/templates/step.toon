# OpenCode Runbook v2 Step Template
# Each step in a runbook gets its own file under steps/<step-id>.toon.
# The file name stem MUST match the step id.
#
# Instructions:
# 1. Replace placeholder values with actual step data.
# 2. Ensure the file name matches steps/<step-id>.toon.
# 3. The id field here must match the id in main.toon's steps index entry.

id: <step-id>
depends_on[0]:
parallel_group: default
worker:
  family: <family>
  size: <size>
skill: null
minimum_capable_tier: <tier>
context_package:
  user_requirement_slice: Description of what this step needs to accomplish
  relevant_proposal_sections[0]:
  relevant_state_files[0]:
  files_in_scope[<count>]: <path>,<path>
  files_out_scope[<count>]: <path>,<path>
  expected_return_format: <format-description>
objective: Bounded objective for this step
expected_output: What this step should produce
state_updates[<count>]: <state-file>,<state-file>
acceptance_criteria[<count>]:
  - Criterion for determining step success
  - Another criterion
verification: How to verify this step
recovery: What to do if this step fails