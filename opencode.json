{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "model": "openrouter/deepseek/deepseek-v4-pro",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen3.5:0.8b": {
          "name": "Qwen 3.5 0.8B"
        },
        "qwen3:1.7b": {
          "name": "Qwen3 1.7B"
        },
        "qwen3.5:2b": {
          "name": "Qwen 3.5 2B"
        },
        "granite4.1:3b": {
          "name": "Granite 4.1 3B"
        },
        "phi4-mini": {
          "name": "Phi-4 Mini"
        },
        "qwen2.5-coder:1.5b": {
          "name": "Qwen2.5 Coder 1.5B"
        },
        "qwen2.5-coder:3b": {
          "name": "Qwen2.5 Coder 3B"
        },
        "qwen3-vl:2b-thinking": {
          "name": "Qwen3 VL 2B Thinking"
        },
        "qwen3-vl:8b-thinking": {
          "name": "Qwen3 VL 8B Thinking"
        },
        "qwen3:8b": {
          "name": "Qwen3 8B"
        },
        "deepseek-r1:8b": {
          "name": "DeepSeek R1 8B"
        },
        "command-r7b": {
          "name": "Command R7B"
        },
        "llama3-groq-tool-use:8b": {
          "name": "Llama3 Groq Tool Use 8B"
        },
        "glm-4.7-flash": {
          "name": "GLM 4.7 Flash"
        },
        "qwen25-coder-7b-16k": {
          "name": "Qwen2.5-Coder 7B 16K"
        },
        "qwen3-8b-12k": {
          "name": "Qwen3 8B 12K"
        },
        "granite41-8b-12k": {
          "name": "Granite 4.1 8B 12K"
        },
        "worker-xs-local": {
          "name": "Worker XS Local"
        },
        "worker-sm-local": {
          "name": "Worker SM Local"
        },
        "worker-md-local": {
          "name": "Worker MD Local"
        }
      }
    }
  },
  "agent": {
    "orchestrator-base": {
      "description": "Hidden base orchestrator pattern for aggressive delegation, proposal-plan-execution workflows, runbook-driven execution, review, and retro loops.",
      "mode": "subagent",
      "hidden": true,
      "model": "openrouter/deepseek/deepseek-v4-pro",
      "prompt": "{file:./prompts/orchestrator-base.md}",
      "permission": {
        "*": "deny",
        "task": {
          "*": "deny",
          "worker": "allow",
          "nano-reader": "allow",
          "multimodal-looker": "allow"
        },
        "skill": {
          "*": "allow"
        }
      }
    },
    "agent-architect": {
      "description": "Primary orchestrator for creating and improving OpenCode agents, skills, commands, migrations, and the orchestration harness.",
      "mode": "primary",
      "model": "openrouter/deepseek/deepseek-v4-pro",
      "prompt": "{file:./prompts/orchestrator-base.md}\n\n{file:./prompts/agent-architect.md}",
      "permission": {
        "*": "deny",
        "task": {
          "*": "deny",
          "worker": "allow",
          "nano-reader": "allow",
          "multimodal-looker": "allow",
          "orchestrator-base": "allow"
        },
        "skill": {
          "*": "allow"
        }
      }
    }
  },
  "plugin": []
}
